#!/usr/bin/env python3
"""Generate a trigger test for every skill description in this repo.

A description is the only part of a skill loaded into context unconditionally,
so its single job is to fire on the right prompts and stay silent otherwise.
Over-triggering is the expensive failure: a wrongly-pulled skill burns context
on requests it has no business touching.

This cannot judge on its own, because the thing being tested is how a model
reads the descriptions. It emits a prompt to paste into a fresh agent that has
no other context, then scores what comes back.

    ./bin/test-descriptions            # print the judge prompt
    ./bin/test-descriptions --answers  # print expected results for scoring
    ./bin/test-descriptions --score results.txt

The judge must not see the expected answers, must judge each prompt
independently, and must be told the mix is unbalanced — otherwise it infers that
roughly half should fire and starts matching to hit that ratio.
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PROMPTS = ROOT / "tests" / "prompts.tsv"


def descriptions() -> list[tuple[str, str]]:
    """Return (name, description) for every skill, in stable order."""
    out = []
    for path in sorted(ROOT.glob("skills/*/*/SKILL.md")):
        text = path.read_text()
        name = re.search(r"^name:\s*(.+)$", text, re.M)
        desc = re.search(r"^description:\s*(.+)$", text, re.M)
        if name and desc:
            out.append((name.group(1).strip(), desc.group(1).strip()))
    return out


def cases() -> list[tuple[str, str]]:
    """Return (prompt, expected) pairs; expected is a skill name or NONE."""
    rows = []
    for line in PROMPTS.read_text().splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        prompt, expected = line.split("\t")
        rows.append((prompt.strip(), expected.strip()))
    return rows


def judge_prompt() -> str:
    skills = "\n".join(
        f"{i}. {n} — \"{d}\"" for i, (n, d) in enumerate(descriptions(), 1)
    )
    prompts = "\n".join(
        f"{i}. {p}" for i, (p, _) in enumerate(cases(), 1)
    )
    return f"""You are testing skill-discovery behavior. Below are the ONLY skills available in a hypothetical session. You see their descriptions exactly as a model would see them in its system prompt.

AVAILABLE SKILLS:
{skills}

Judge each prompt INDEPENDENTLY. Do not let one answer influence another. Many prompts match NO skill — do not force a match, and do not assume any particular ratio of matches to non-matches. More than one skill may legitimately fire for a single prompt; say so if that is the case.

PROMPTS:
{prompts}

For each, output exactly one line:
<number>. FIRES: <skill-name or NONE> | CONFIDENCE: <high/medium/low> | WHY: <one sentence quoting the deciding words from the description>

Then add a TEMPTED-BUT-REJECTED section: for each prompt, name any skill you nearly fired and the exact wording that made it tempting. This section matters more than the answers — a description that produces the right answer for the wrong reason will break on the next prompt.

Finally: name any description you consider ambiguous or over-broad, and any "Not for..." clause that would wrongly suppress a case the skill SHOULD handle."""


def score(path: str) -> int:
    """Compare a judge's output against expected results.

    Parses lines of the form '<n>. FIRES: <skill>' and reports mismatches.
    Medium/low confidence on a correct answer is surfaced too: it means the
    description decided the case narrowly and is a description worth tightening.
    """
    text = Path(path).read_text()
    got = {}
    for m in re.finditer(r"^\s*(\d+)\.\s*FIRES:\s*([\w-]+)(.*)$", text, re.M):
        got[int(m.group(1))] = (m.group(2).strip(), m.group(3))

    rows = cases()
    fails, shaky = [], []
    for i, (prompt, expected) in enumerate(rows, 1):
        if i not in got:
            fails.append(f"  [{i}] no verdict parsed — {prompt!r}")
            continue
        actual, rest = got[i]
        if actual.lower() != expected.lower():
            fails.append(f"  [{i}] {prompt!r}\n      expected {expected}, got {actual}")
        elif re.search(r"CONFIDENCE:\s*(medium|low)", rest, re.I):
            shaky.append(f"  [{i}] {prompt!r} → {actual} (low confidence)")

    print(f"{len(rows) - len(fails)}/{len(rows)} correct")
    if fails:
        print("\nFAILURES:")
        print("\n".join(fails))
    if shaky:
        print("\nCORRECT BUT NARROW — tighten these descriptions:")
        print("\n".join(shaky))
    return 1 if fails else 0


if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--answers":
        for i, (p, e) in enumerate(cases(), 1):
            print(f"{i}. {e:20} {p}")
    elif arg == "--score":
        raise SystemExit(score(sys.argv[2]))
    else:
        print(judge_prompt())
